{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AI University mathematics series catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["subject", "areas", "volumes"],
  "properties": {
    "subject": { "const": "数学" },
    "areas": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "english",
          "question",
          "description",
          "symbol"
        ],
        "properties": {
          "id": { "$ref": "#/definitions/id" },
          "title": { "$ref": "#/definitions/text" },
          "english": { "$ref": "#/definitions/text" },
          "question": { "$ref": "#/definitions/text" },
          "description": { "$ref": "#/definitions/text" },
          "symbol": {
            "enum": [
              "calculus",
              "linear",
              "dynamics",
              "probability",
              "discrete",
              "analysis"
            ]
          }
        }
      }
    },
    "volumes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "areaId",
          "title",
          "englishTitle",
          "coverTitle",
          "tagline",
          "description",
          "audience",
          "scope",
          "status"
        ],
        "properties": {
          "id": { "$ref": "#/definitions/id" },
          "areaId": { "$ref": "#/definitions/id" },
          "title": { "$ref": "#/definitions/text" },
          "englishTitle": { "$ref": "#/definitions/text" },
          "coverTitle": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/definitions/text" }
          },
          "tagline": { "$ref": "#/definitions/text" },
          "description": { "$ref": "#/definitions/text" },
          "audience": { "$ref": "#/definitions/text" },
          "scope": { "$ref": "#/definitions/text" },
          "status": { "enum": ["published", "planned"] },
          "route": { "type": "string", "pattern": "^book/[a-z][a-z0-9-]*$" },
          "coverFormula": { "$ref": "#/definitions/text" },
          "stats": {
            "type": "object",
            "additionalProperties": false,
            "required": ["chapters", "lessons", "examples", "exercises"],
            "properties": {
              "chapters": { "$ref": "#/definitions/count" },
              "lessons": { "$ref": "#/definitions/count" },
              "examples": { "$ref": "#/definitions/count" },
              "exercises": { "$ref": "#/definitions/count" }
            }
          }
        },
        "allOf": [
          {
            "if": { "properties": { "status": { "const": "published" } } },
            "then": { "required": ["route", "coverFormula", "stats"] }
          },
          {
            "if": { "properties": { "status": { "const": "planned" } } },
            "then": {
              "not": {
                "anyOf": [
                  { "required": ["route"] },
                  { "required": ["stats"] },
                  { "required": ["coverFormula"] }
                ]
              }
            }
          }
        ]
      }
    }
  },
  "definitions": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "text": { "type": "string", "minLength": 1 },
    "count": { "type": "integer", "minimum": 1 }
  }
}
