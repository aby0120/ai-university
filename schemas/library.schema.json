{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AI University textbook catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "subject",
    "areas",
    "volumes",
    "categories"
  ],
  "properties": {
    "subject": {
      "const": "开放教科书"
    },
    "areas": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "english",
          "question",
          "description",
          "symbol",
          "categoryId"
        ],
        "properties": {
          "id": {
            "$ref": "#/definitions/id"
          },
          "title": {
            "$ref": "#/definitions/text"
          },
          "english": {
            "$ref": "#/definitions/text"
          },
          "question": {
            "$ref": "#/definitions/text"
          },
          "description": {
            "$ref": "#/definitions/text"
          },
          "symbol": {
            "enum": [
              "calculus",
              "linear",
              "dynamics",
              "probability",
              "discrete",
              "analysis",
              "code"
            ]
          },
          "categoryId": {
            "$ref": "#/definitions/id"
          }
        }
      }
    },
    "volumes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "areaId",
          "title",
          "englishTitle",
          "coverTitle",
          "tagline",
          "description",
          "audience",
          "scope",
          "status",
          "categoryId"
        ],
        "properties": {
          "id": {
            "$ref": "#/definitions/id"
          },
          "areaId": {
            "$ref": "#/definitions/id"
          },
          "title": {
            "$ref": "#/definitions/text"
          },
          "englishTitle": {
            "$ref": "#/definitions/text"
          },
          "coverTitle": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/definitions/text"
            }
          },
          "tagline": {
            "$ref": "#/definitions/text"
          },
          "description": {
            "$ref": "#/definitions/text"
          },
          "audience": {
            "$ref": "#/definitions/text"
          },
          "scope": {
            "$ref": "#/definitions/text"
          },
          "status": {
            "enum": [
              "published",
              "planned"
            ]
          },
          "route": {
            "type": "string",
            "pattern": "^book/[a-z][a-z0-9-]*$"
          },
          "coverFormula": {
            "$ref": "#/definitions/text"
          },
          "stats": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "chapters",
              "lessons",
              "examples",
              "exercises"
            ],
            "properties": {
              "chapters": {
                "$ref": "#/definitions/count"
              },
              "lessons": {
                "$ref": "#/definitions/count"
              },
              "examples": {
                "$ref": "#/definitions/count"
              },
              "exercises": {
                "$ref": "#/definitions/count"
              }
            }
          },
          "categoryId": {
            "$ref": "#/definitions/id"
          },
          "coverMark": {
            "$ref": "#/definitions/text"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "published"
                }
              }
            },
            "then": {
              "required": [
                "route",
                "stats"
              ],
              "oneOf": [
                {
                  "required": [
                    "coverFormula"
                  ]
                },
                {
                  "required": [
                    "coverMark"
                  ]
                }
              ]
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "const": "planned"
                }
              }
            },
            "then": {
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "route"
                    ]
                  },
                  {
                    "required": [
                      "stats"
                    ]
                  },
                  {
                    "required": [
                      "coverFormula"
                    ]
                  },
                  {
                    "required": [
                      "coverMark"
                    ]
                  }
                ]
              }
            }
          }
        ]
      }
    },
    "categories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "english",
          "description"
        ],
        "properties": {
          "id": {
            "$ref": "#/definitions/id"
          },
          "title": {
            "$ref": "#/definitions/text"
          },
          "english": {
            "$ref": "#/definitions/text"
          },
          "description": {
            "$ref": "#/definitions/text"
          }
        }
      }
    }
  },
  "definitions": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "count": {
      "type": "integer",
      "minimum": 1
    }
  }
}
