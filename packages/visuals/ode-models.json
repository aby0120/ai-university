          "min": 0.25,
          "max": 3,
          "value": 1,
          "step": 0.01
        }
      ],
      "formula": "y'=1+y/t,\\quad y=t(\\ln t+C)"
    },
    "logistic": {
      "controls": [
        {
          "key": "a",
          "label": "初始值 $y_0$",
          "min": 0.1,
          "max": 2,
          "value": 0.5,
          "step": 0.01
        },
        {
          "key": "b",
          "label": "观察时间 $t$",
          "min": 0,
          "max": 6,
          "value": 2,
          "step": 0.01
        }
      ],
      "formula": "y'=y(1-y),\\quad y=\\frac1{1+(1/y_0-1)e^{-t}}"
    },
    "nonunique": {
      "controls": [
        {
          "key": "a",
