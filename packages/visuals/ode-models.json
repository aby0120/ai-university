  "families": {
    "exponential": {
      "controls": [
        {
          "key": "a",
          "label": "比例系数 $k$",
          "min": -1,
          "max": 1,
          "value": 0.5,
          "step": 0.01
        },
        {
          "key": "c",
          "label": "初始值 $y_0$",
          "min": -2,
          "max": 2,
          "value": 1,
          "step": 0.01
        },
        {
          "key": "b",
          "label": "观察时间 $t$",
          "min": 0,
          "max": 3,
          "value": 1,
          "step": 0.01
        }
      ],
      "formula": "y'=ky,\\quad y=y_0e^{kt}"
    },
    "field": {
      "controls": [
        {
          "key": "a",
          "label": "初始值 $y_0$",
          "min": -2,
          "max": 2,
          "value": 1,
          "step": 0.01
        },
        {
          "key": "b",
          "label": "观察时间 $t$",
          "min": 0,
          "max": 3,
          "value": 1,
          "step": 0.01
        }
      ],
      "formula": "y'=y-t,\\quad y=t+1+(y_0-1)e^t"
    },
    "blowup": {
      "controls": [
        {
          "key": "a",
          "label": "正初值 $y_0$",
          "min": 0.25,
          "max": 2,
          "value": 1,
          "step": 0.01
        },
        {
          "key": "b",
          "label": "观察时间 $t$",
          "min": 0,
          "max": 3,
          "value": 0.5,
          "step": 0.01
        }
      ],
      "formula": "y'=y^2,\\quad y=\\frac{y_0}{1-y_0t},\\quad T=1/y_0"
    },
    "separable": {
      "controls": [
        {
          "key": "a",
          "label": "初始值 $y_0$",
          "min": -2,
          "max": 2,
          "value": 1,
          "step": 0.01
        },
        {
          "key": "b",
          "label": "观察时间 $t$",
          "min": 0,
          "max": 3,
          "value": 1,
          "step": 0.01
        }
      ],
      "formula": "y'=ty,\\quad y=y_0e^{t^2/2}"
    },
    "linear": {
      "controls": [
        {
          "key": "a",
          "label": "初始值 $y_0$",
          "min": -2,
          "max": 2,
          "value": 1,
          "step": 0.01
        },
        {
          "key": "b",
          "label": "观察时间 $t$",
          "min": 0,
          "max": 3,
          "value": 1,
          "step": 0.01
        }
      ],
      "formula": "y'+y=1,\\quad y=1+(y_0-1)e^{-t}"
    },
    "exact": {
      "controls": [
        {
          "key": "a",
          "label": "等值线半径 $R$",
          "min": 0.5,
          "max": 2,
          "value": 1,
          "step": 0.01
        },
        {
          "key": "b",
          "label": "轨迹角 $\\theta$",
          "min": 0,
          "max": 6.283185307179586,
          "value": 1,
          "step": 0.01
        }
      ],
      "formula": "t\\,dt+y\\,dy=0,\\quad t^2+y^2=R^2"
    },
    "homogeneous": {
      "controls": [
        {
          "key": "a",
          "label": "积分常数 $C$",
          "min": -1,
          "max": 1,
          "value": 0,
