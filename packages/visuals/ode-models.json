          "min": 0,
          "max": 3,
          "value": 2,
          "step": 0.01
        }
      ],
      "formula": "y'=3\\lvert y\\rvert^{2/3},\\quad y=(t-c)_+^3"
    },
    "picard": {
      "controls": [
        {
          "key": "n",
          "label": "迭代次数 $n$",
          "min": 0,
          "max": 8,
          "value": 2,
          "step": 1
        },
        {
          "key": "b",
          "label": "观察时间 $t$",
          "min": 0,
          "max": 2,
          "value": 1,
          "step": 0.01
        }
      ],
      "formula": "y'=y,\\ y(0)=1,\\quad y_n=\\sum_{k=0}^n\\frac{t^k}{k!}"
    },
    "sensitivity": {
      "controls": [
        {
          "key": "a",
          "label": "增长率 $k$",
          "min": -1,
          "max": 1,
          "value": 0.5,
          "step": 0.01
