  "number": "5.1",
  "title": "行列式与有向体积",
  "subtitle": "有向体积缩放了多少",
  "concept": "行列式的绝对值是体积倍率，符号记录定向是否翻转。",
  "intuition": "单位正方形或立方体被矩阵送成平行四边形或平行六面体；压成低维时，面积或体积倍率变为零。",
  "objectives": [
    "计算面积和体积倍率",
    "区分定向符号与几何大小"
  ],
  "body": [
    {
      "title": "二维怎样计算？",
      "text": "两列 $(a,c),(b,d)$ 张成的有向面积为 $ad-bc$。面积是其绝对值，不是有符号数。"
    },
    {
      "title": "三维怎样理解？",
      "text": "三列张成平行六面体。交换两列改变定向但不改变几何体积；三列共面时体积为零。"
    },
    {
      "title": "行列式能概括一切吗？",
      "text": "不能。同样的体积倍率可以来自不同的拉伸和剪切。面积保持也不保证长度或角度保持。"
    }
  ],
  "formalDefinition": {
    "text": "行列式与有向体积",
    "latex": "\\det\\begin{pmatrix}a&b\\\\c&d\\end{pmatrix}=ad-bc,\\quad \\operatorname{vol}(A[0,1]^n)=|\\det A|",
    "conditions": [
      "行列式对方阵定义；体积使用同维欧氏体积，退化像的该维体积为零。"
    ]
  },
  "derivation": [
    {
      "text": "先看对角拉伸。",
      "latex": "\\det\\operatorname{diag}(s_1,\\ldots,s_n)=\\prod_i s_i"
    },
    {
      "text": "交换两方向反转定向。",
      "latex": "\\det[a_2,a_1,\\ldots]=-\\det[a_1,a_2,\\ldots]"
    },
    {
      "text": "线性依赖使同维体积消失。",
      "latex": "\\operatorname{rank}A<n\\Rightarrow\\det A=0"
    }
  ],
  "workedExamples": [
    {
      "title": "面积与定向",
      "problem": "$A=\\begin{pmatrix}1&2\\\\3&1\\end{pmatrix}$ 将单位正方形变成多大面积？",
      "steps": [
        "$\\det A=1-6=-5$。",
        "取绝对值为面积倍率，负号表示定向反转。"
      ],
      "answer": "面积为 5，定向反转。"
    },
    {
      "title": "空间体积",
      "problem": "$A=\\operatorname{diag}(2,3,-1)$ 的体积倍率？",
      "steps": [
        "行列式为 $-6$。",
        "几何体积取绝对值。"
      ],
      "answer": "6，定向反转。"
    }
  ],
