  "number": "1.5",
  "title": "参数形式与完整解集",
  "subtitle": "特解决定位置，齐次解决定方向",
  "concept": "一个特解加上齐次解，给出相容线性方程组的全部解。",
  "intuition": "两个解都满足同样的右端，它们相减后右端消失。所有解之间的差，都属于同一个齐次解集。",
  "objectives": [
    "用自由参数写出全部解",
    "区分线性子空间与仿射解集"
  ],
  "body": [
    {
      "title": "参数从哪里来？",
      "text": "给自由变量各取一个参数，用主元方程表达其余变量。不要额外限制未被方程限制的参数。"
    },
    {
      "title": "为什么要分成两部分？",
      "text": "固定一个特解 $\\mathbf x_p$，再加任意齐次解 $\\mathbf z$。$A\\mathbf z=0$ 保证右端不变。"
    },
    {
      "title": "解集一定经过原点吗？",
      "text": "齐次解集一定经过原点；非齐次相容解集通常是它的平移，称仿射集合。"
    }
  ],
  "formalDefinition": {
    "text": "参数形式与完整解集",
    "latex": "\\{x:Ax=b\\}=x_p+\\ker A\\qquad(Ax_p=b)",
    "conditions": [
      "公式要求存在特解；无解时不能写一个虚构特解。参数遍历整个实数域。",
      "这里 $\\ker A=\\{z:Az=0\\}$，就是齐次方程组的解集。"
    ]
  },
  "derivation": [
    {
      "text": "任意两个解相减。",
      "latex": "A(x-x_p)=b-b=0"
    },
    {
      "text": "反过来加上齐次解。",
      "latex": "A(x_p+z)=b+0=b"
    },
    {
      "text": "这就证明没有遗漏。",
      "latex": "x=x_p+z,\\quad z\\in\\ker A"
    }
  ],
  "workedExamples": [
    {
      "title": "一条仿射直线",
      "problem": "解 $x+y+z=2,x-y+z=0$。",
      "steps": [
        "两式相减得 $y=1$，再得 $x+z=1$。",
        "令 $z=t$，则 $(x,y,z)=(1,1,0)+t(-1,0,1)$。"
      ],
      "answer": "$t\\in\\mathbb R$ 的整条直线。"
    },
    {
      "title": "两个自由变量",
      "problem": "解 $x+2y-z=3$。",
      "steps": [
        "令 $y=s,z=t$。",
        "$x=3-2s+t$，整理常量与两个参数。"
      ],
      "answer": "$(x,y,z)=(3,0,0)+s(-2,1,0)+t(1,0,1)$。"
    }
  ],
