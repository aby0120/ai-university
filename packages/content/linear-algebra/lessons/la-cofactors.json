  "title": "余子式展开与行列式定义",
  "subtitle": "把高阶展开为低阶",
  "concept": "沿一行或一列展开，把高阶行列式递归拆成低阶行列式。",
  "intuition": "每个元素贡献一个较小的行列式，符号交替；选择零最多的行或列，计算往往更短。",
  "objectives": [
    "正确计算代数余子式",
    "选择合适的行或列展开"
  ],
  "body": [
    {
      "title": "余子式是什么？",
      "text": "删去第 $i$ 行第 $j$ 列得到子矩阵 $M_{ij}$；代数余子式为 $C_{ij}=(-1)^{i+j}\\det M_{ij}$。"
    },
    {
      "title": "怎样展开？",
      "text": "固定一行，将该行元素分别乘其代数余子式再相加。列展开同样成立。"
    },
    {
      "title": "大矩阵也这样算吗？",
      "text": "手算用于小矩阵、稀疏矩阵和理论推导。一般大矩阵反复递归展开代价很高，通常用分解。"
    }
  ],
  "formalDefinition": {
    "text": "余子式展开与行列式定义",
    "latex": "\\det A=\\sum_j a_{ij}(-1)^{i+j}\\det M_{ij}",
    "conditions": [
      "沿同一行或同一列展开；递归以一阶行列式为元素本身，零阶行列式约定为一。"
    ]
  },
  "derivation": [
    {
      "text": "置换求和式按固定行选到的列分组。",
      "latex": "\\det A=\\sum_{\\pi\\in S_n}\\operatorname{sgn}(\\pi)\\prod_i a_{i,\\pi(i)}"
    },
    {
      "text": "每组留下一个较小的置换求和。",
      "latex": "\\text{固定 }\\pi(i)=j\\Rightarrow a_{ij}(-1)^{i+j}\\det M_{ij}"
    },
    {
      "text": "将这些互不遗漏的组相加。",
      "latex": "\\det A=\\sum_j a_{ij}C_{ij}"
    }
  ],
  "workedExamples": [
