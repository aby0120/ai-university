  "body": [
    {
      "title": "一条线怎样投影？",
      "text": "沿非零 $u$ 的投影是 $u(u^Tb)/(u^Tu)$。系数可为负，不必投在画出的正向射线上。"
    },
    {
      "title": "最近点为何唯一？",
      "text": "任意另一个候选与投影之差在子空间内，和余量垂直；勾股展开后距离只会增加。"
    },
    {
      "title": "有正交基时怎样做？",
      "text": "若 $q_j$ 标准正交，分别取点积系数后相加。斜基不能直接照搬这个公式。"
    }
  ],
  "formalDefinition": {
    "text": "向量投影与最近点",
    "latex": "p=\\frac{u^Tb}{u^Tu}u,\\quad r=b-p,\\quad u^Tr=0;\\qquad P_Wb=QQ^Tb",
    "conditions": [
      "一维公式要求 $u\\ne0$；后式要求 $Q$ 的列是目标子空间的一组标准正交基。"
    ]
  },
  "derivation": [
    {
      "text": "让余量与方向垂直。",
      "latex": "u^T(b-cu)=0"
    },
    {
      "text": "解投影系数。",
      "latex": "c=\\frac{u^Tb}{u^Tu}"
    },
    {
      "text": "其他候选多出一个非负平方。",
      "latex": "\\|b-w\\|^2=\\|b-p\\|^2+\\|p-w\\|^2"
    }
  ],
