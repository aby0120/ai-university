  "body": [
    {
      "title": "向量记录什么？",
      "text": "$\\mathbb R^n$ 中的向量有 $n$ 个实分量。相同维数才能相加，逐分量运算；本书默认列向量。"
    },
    {
      "title": "系数起什么作用？",
      "text": "$a\\mathbf u+b\\mathbf v$ 把两个方向各取一份带符号的倍数，再相加。负系数允许反向，零系数表示不用该向量。"
    },
    {
      "title": "怎样检查一种表示？",
      "text": "逐分量代回。图上看似接近不是相等；同一个向量也可能有不止一种线性组合表示。"
    }
  ],
  "formalDefinition": {
    "text": "向量与线性组合",
    "latex": "\\mathbf w=\\sum_{j=1}^k c_j\\mathbf v_j,\\qquad (u+v)_i=u_i+v_i",
    "conditions": [
      "所有向量属于同一实坐标空间；系数为实数。"
    ]
  },
  "derivation": [
    {
      "text": "先按分量缩放。",
      "latex": "a\\binom{u_1}{u_2}=\\binom{au_1}{au_2}"
    },
    {
      "text": "再相加。",
      "latex": "a\\mathbf u+b\\mathbf v=\\binom{au_1+bv_1}{au_2+bv_2}"
    },
    {
      "text": "比较每个分量。",
      "latex": "a\\mathbf u+b\\mathbf v=\\mathbf w\\iff au_i+bv_i=w_i\\quad(1\\le i\\le n)"
    }
  ],
  "workedExamples": [
    {
      "title": "从系数到向量",
      "problem": "$\\mathbf u=(1,2),\\mathbf v=(2,-1)$，求 $2\\mathbf u-\\mathbf v$。",
      "steps": [
        "$2\\mathbf u=(2,4)$。",
        "相减得 $(0,5)$。"
      ],
      "answer": "$(0,5)$。"
    },
    {
      "title": "从向量到系数",
      "problem": "将 $(5,1)$ 写成 $(1,1)$ 和 $(1,-1)$ 的线性组合。",
      "steps": [
        "系数满足 $a+b=5,a-b=1$。",
        "相加得 $a=3$，再得 $b=2$。"
      ],
      "answer": "$(5,1)=3(1,1)+2(1,-1)$。"
    }
  ],
