  "body": [
    {
      "title": "矩阵尺寸表示什么？",
      "text": "$m\\times n$ 矩阵接收 $n$ 个数，输出 $m$ 个数。矩阵加法要求尺寸一致，转置交换行与列。"
    },
    {
      "title": "矩阵怎样乘？",
      "text": "$AB$ 的第 $j$ 列是 $A$ 乘 $B$ 的第 $j$ 列。逐元素写，就是左边一行与右边一列的乘积之和。"
    },
    {
      "title": "顺序重要吗？",
      "text": "通常 $AB\\ne BA$，有时其中一种顺序甚至没有定义。转置会反转乘积顺序。"
    }
  ],
  "formalDefinition": {
    "text": "矩阵、转置与矩阵乘法",
    "latex": "(AB)_{ij}=\\sum_{k=1}^n A_{ik}B_{kj},\\quad(AB)^T=B^TA^T",
    "conditions": [
      "若 $A$ 为 $m\\times n$，则 $B$ 的行数须为 $n$；结果行数来自 $A$、列数来自 $B$。"
    ]
  },
  "derivation": [
    {
      "text": "先把右矩阵看成列。",
      "latex": "B=[b_1\\ \\cdots\\ b_p]"
    },
    {
      "text": "左矩阵逐列作用。",
      "latex": "AB=[Ab_1\\ \\cdots\\ Ab_p]"
    },
    {
      "text": "按分量展开。",
      "latex": "(Ab_j)_i=\\sum_k A_{ik}(b_j)_k"
    }
  ],
  "workedExamples": [
