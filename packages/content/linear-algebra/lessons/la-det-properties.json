  "title": "行列式的运算规则",
  "subtitle": "跟着消元计算行列式",
  "concept": "行操作和乘积规则，让行列式计算可以跟着消元走。",
  "intuition": "加上一行的倍数只是剪切，体积不变；交换两行改变符号；缩放一行按同样倍数缩放行列式。",
  "objectives": [
    "记录行操作对行列式的影响",
    "使用乘积与转置公式"
  ],
  "body": [
    {
      "title": "三种行操作分别怎样影响？",
      "text": "交换两行乘 $-1$；一行乘 $c$，行列式也乘 $c$；一行加另一行的倍数不变。列操作也有同样规则。"
    },
    {
      "title": "三角矩阵怎样算？",
      "text": "上、下三角矩阵的行列式都是对角线元素之积。消元过程中必须记录交换和缩放的影响。"
    },
    {
      "title": "乘积与转置呢？",
      "text": "$\\det(AB)=\\det A\\det B$，$\\det A^T=\\det A$；通常没有 $\\det(A+B)=\\det A+\\det B$。"
    }
  ],
  "formalDefinition": {
    "text": "行列式的运算规则",
    "latex": "\\det(AB)=\\det A\\det B,\\quad\\det A^T=\\det A,\\quad\\det(cA)=c^n\\det A",
    "conditions": [
      "乘积公式中矩阵同为 $n\\times n$；整矩阵乘常数会缩放所有行。"
    ]
  },
  "derivation": [
    {
      "text": "把一行的线性组合展开。",
      "latex": "\\det(\\ldots,r_i+cr_j,\\ldots)=\\det A+c\\det(\\ldots,r_j,\\ldots)"
    },
    {
      "text": "后一项有相同行，故为零。",
      "latex": "R_i\\leftarrow R_i+cR_j\\Rightarrow\\det\\text{ 不变}"
    },
    {
      "text": "化成三角形并补回交换符号。",
      "latex": "\\det A=(-1)^s\\prod_i u_{ii}\\quad\\text{若仅加行与交换}"
    }
  ],
  "workedExamples": [
    {
      "title": "消元不必展开",
      "problem": "求 $\\det\\begin{pmatrix}1&2&0\\\\2&5&1\\\\0&0&3\\end{pmatrix}$。",
      "steps": [
        "第二行减第一行两倍，变为 $(0,1,1)$。",
        "上三角对角积为 $1\\cdot1\\cdot3$。"
      ],
      "answer": "3。"
    },
    {
      "title": "整矩阵缩放",
      "problem": "$A$ 为三阶且 $\\det A=2$，求 $\\det(3A)$。",
      "steps": [
        "三行都乘三，总倍率 $3^3$。",
        "$27\\cdot2=54$。"
      ],
      "answer": "54。"
    }
  ],
