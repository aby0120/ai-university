  "body": [
    {
      "title": "矩阵如何建立？",
      "text": "为每条边任选方向，对应列在起点写 $-1$、终点写 $1$，其他为零。边流量允许负数，表示实际流向相反。"
    },
    {
      "title": "核意味着什么？",
      "text": "$Bf=0$ 是每个节点都守恒的循环流；$B^Tp=0$ 表示每条边两端势相同，所以 $p$ 在每个连通分量内为常数。"
    },
    {
      "title": "拉普拉斯矩阵是什么？",
      "text": "$L=BB^T$ 为对称半正定。其二次型是所有相邻节点差平方的和；连通图的核由全一向量生成。"
    }
  ],
  "formalDefinition": {
    "text": "图、关联矩阵与网络守恒",
    "latex": "b=Bf,\\quad\\mathbf1^TB=0,\\quad L=BB^T,\\quad p^TLp=\\|B^Tp\\|^2",
    "conditions": [
      "有限无向图先人为指定边方向；无自环的常用关联约定。多连通分量分别满足总净流入为零。"
    ]
  },
  "derivation": [
    {
      "text": "每条边的列和为零。",
      "latex": "\\mathbf1^TB=0"
    },
    {
      "text": "因此总净流入为零。",
      "latex": "\\mathbf1^Tb=\\mathbf1^TBf=0"
    },
    {
      "text": "相邻节点相同势时平方和为零。",
      "latex": "\\ker L=\\ker B^T=\\{\\text{各连通分量上的常量}\\}"
    }
  ],
  "workedExamples": [
    {
      "title": "三角形循环",
      "problem": "三节点边按 $1\\to2,2\\to3,3\\to1$ 定向，流量 $(1,1,1)$。",
      "steps": [
        "$B=\\begin{pmatrix}-1&0&1\\\\1&-1&0\\\\0&1&-1\\end{pmatrix}$。",
        "每个节点一进一出，$Bf=0$。"
      ],
      "answer": "这是非零循环流。"
    },
    {
      "title": "求全部满足给定净流入的流量",
      "problem": "同一图要求 $b=(1,-1,0)$。",
      "steps": [
        "方程给 $f_3-f_1=1,f_1-f_2=-1,f_2-f_3=0$。",
        "令 $f_2=f_3=t$，则 $f_1=t-1$。"
      ],
      "answer": "$f=(-1,0,0)+t(1,1,1)$。"
    }
  ],
