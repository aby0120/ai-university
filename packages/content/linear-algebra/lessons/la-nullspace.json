  "body": [
    {
      "title": "怎样求一组基？",
      "text": "消元解 $Ax=0$。每次让一个自由变量为一、其余自由变量为零，得到特殊解；这些特殊解构成零空间的基。"
    },
    {
      "title": "核属于哪里？",
      "text": "$m\\times n$ 矩阵的核属于输入空间 $\\mathbb R^n$，不是输出空间。"
    },
    {
      "title": "核与一一性怎样连接？",
      "text": "映射一一当且仅当核只有零向量。若 $Ax=Ay$，就有 $A(x-y)=0$。"
    }
  ],
  "formalDefinition": {
    "text": "核与零空间",
    "latex": "\\ker A=\\{x\\in\\mathbb R^n:Ax=0\\},\\qquad A\\text{ 一一}\\iff\\ker A=\\{0\\}",
    "conditions": [
      "矩阵代表线性映射；零空间自动是输入空间的子空间。"
    ]
  },
  "derivation": [
    {
      "text": "等输出相减。",
      "latex": "Ax=Ay\\Rightarrow A(x-y)=0"
    },
    {
      "text": "零核强制输入相同。",
      "latex": "\\ker A=\\{0\\}\\Rightarrow x=y"
    },
    {
      "text": "非零核向量给不同的同输出输入。",
      "latex": "Az=0,z\\ne0\\Rightarrow A(x+z)=Ax"
    }
  ],
  "workedExamples": [
