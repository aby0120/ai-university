  "body": [
    {
      "title": "哪些行操作合法？",
      "text": "交换两行；一行乘非零数；一行加另一行的倍数。这三种操作都可逆。"
    },
    {
      "title": "增广矩阵怎么用？",
      "text": "把系数和右端并排写成 $[A\\mid\\mathbf b]$。每一次行操作必须作用于整行，包括右端。"
    },
    {
      "title": "何时回代？",
      "text": "得到阶梯形后，从最后一个非零方程向上求解。若继续把主元上下都消为零并化为一，可得到简化阶梯形。"
    }
  ],
  "formalDefinition": {
    "text": "高斯消元与等价行变换",
    "latex": "R_i\\leftarrow R_i+cR_j\\quad(i\\ne j),\\qquad [A\\mid b]\\sim[U\\mid d]",
    "conditions": [
      "一行缩放的倍数不能为零；行变换只保证解集等价，不保证矩阵作为线性映射不变。"
    ]
  },
  "derivation": [
    {
      "text": "先选一个非零主元。",
      "latex": "\\left[\\begin{array}{cc|c}1&1&3\\\\2&3&8\\end{array}\\right]"
    },
    {
      "text": "消去下方系数。",
      "latex": "R_2-2R_1:\\quad\\left[\\begin{array}{cc|c}1&1&3\\\\0&1&2\\end{array}\\right]"
    },
    {
      "text": "再回代或继续消元。",
      "latex": "R_1-R_2:\\quad\\left[\\begin{array}{cc|c}1&0&1\\\\0&1&2\\end{array}\\right]"
    }
  ],
