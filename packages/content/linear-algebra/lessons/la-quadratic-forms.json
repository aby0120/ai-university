  "body": [
    {
      "title": "交叉项怎样写进矩阵？",
      "text": "$ax^2+2bxy+cy^2$ 对应 $\\begin{pmatrix}a&b\\\\b&c\\end{pmatrix}$。非对称部分不影响 $x^TAx$，因此可先取对称部分。"
    },
    {
      "title": "主轴怎样得到？",
      "text": "对对称矩阵用谱分解，令原坐标等于正交矩阵乘新坐标。二次型变为各特征值乘对应坐标平方。"
    },
    {
      "title": "几何形状怎样读？",
      "text": "所有系数正是碗形，正负混合是鞍形，零系数给平坦方向。等值集合还要结合右端符号，不能只看名称猜图。"
    }
  ],
  "formalDefinition": {
    "text": "二次型与主轴",
    "latex": "q(x)=x^TAx=y^T\\Lambda y=\\sum_i\\lambda_i y_i^2,\\qquad x=Qy",
    "conditions": [
      "主轴结论使用实对称矩阵与正交换基；一般相似变换不能直接替代二次型的合同变换。"
    ]
  },
  "derivation": [
    {
      "text": "将谱分解代入。",
      "latex": "x^TAx=x^TQ\\Lambda Q^Tx"
    },
    {
      "text": "设置正交新坐标。",
      "latex": "y=Q^Tx"
    },
    {
      "text": "对角矩阵不产生交叉项。",
      "latex": "y^T\\Lambda y=\\sum_i\\lambda_i y_i^2"
    }
  ],
  "workedExamples": [
    {
      "title": "含交叉项的碗面",
      "problem": "$q=2x^2+2xy+2y^2$ 怎样化为主轴形式？",
      "steps": [
        "矩阵为 $\\begin{pmatrix}2&1\\\\1&2\\end{pmatrix}$。",
        "令 $u=(x+y)/\\sqrt2,v=(x-y)/\\sqrt2$。"
      ],
      "answer": "$q=3u^2+v^2$。"
    },
    {
      "title": "鞍形",
      "problem": "$q=x^2-y^2$ 在原点附近正负如何？",
      "steps": [
        "沿横轴 $q=x^2>0$。",
        "沿纵轴 $q=-y^2<0$。"
      ],
      "answer": "同时有正负，是不定二次型。"
    }
  ],
