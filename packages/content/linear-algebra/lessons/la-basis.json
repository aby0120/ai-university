  "body": [
    {
      "title": "怎样确认是基？",
      "text": "先确认向量都在所讨论空间内，再检查张成与无关。只说“有两个非平行向量”还须说明目标是哪个空间。"
    },
    {
      "title": "怎样从生成集中选基？",
      "text": "把向量放成列做消元，选原矩阵的主元列。它们保留生成能力且互相无关。"
    },
    {
      "title": "基一定标准正交吗？",
      "text": "不需要。斜的、长短不同的基也合法；正交基只是后面特别方便的一种。"
    }
  ],
  "formalDefinition": {
    "text": "基与唯一表示",
    "latex": "B=(v_1,\\ldots,v_k)\\text{ 为基}\\iff \\forall v\\in V,\\ \\exists!c:\\ v=\\sum_jc_jv_j",
    "conditions": [
      "本卷主要使用有限维空间；基作为有序列表使用时，顺序决定坐标顺序。"
    ]
  },
  "derivation": [
    {
      "text": "张成给表示存在。",
      "latex": "v=\\sum_jc_jv_j"
    },
    {
      "text": "若存在两种表示，相减。",
      "latex": "\\sum_j(c_j-d_j)v_j=0"
    },
    {
      "text": "无关性给每个系数相等。",
      "latex": "c_j=d_j\\quad\\forall j"
    }
  ],
  "workedExamples": [
    {
      "title": "非标准基",
      "problem": "$(1,1),(1,-1)$ 是平面的基吗？",
      "steps": [
        "齐次组合只有零系数。",
        "对任意 $(x,y)$，取 $a=(x+y)/2,b=(x-y)/2$。"
      ],
      "answer": "是。"
    },
    {
      "title": "多项式的基",
      "problem": "为何 $1,t,t^2$ 是次数不超过二的实多项式空间的基？",
      "steps": [
        "任意成员都是 $a+bt+ct^2$。",
        "多项式恒等为零要求所有系数为零。"
      ],
      "answer": "张成且无关。"
    }
  ],
