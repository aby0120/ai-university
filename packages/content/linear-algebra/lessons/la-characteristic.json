  "number": "6.2",
  "title": "特征多项式、迹与行列式",
  "subtitle": "先找缩放值，再找方向",
  "concept": "特征多项式找出使矩阵失去可逆性的所有缩放值。",
  "intuition": "把每个方向统一减去同一个缩放；当某个非零方向正好被抵消，便找到了特征值。",
  "objectives": [
    "计算特征多项式",
    "用迹与行列式核对根"
  ],
  "body": [
    {
      "title": "怎样求特征值？",
      "text": "解 $\\det(\\lambda I-A)=0$，再对每个根解 $(A-\\lambda I)v=0$。根本身不等于特征向量。"
    },
    {
      "title": "代数重数是什么？",
      "text": "一个根在特征多项式中重复出现的次数。它不直接说明能找到多少独立特征向量。"
    },
    {
      "title": "迹能告诉什么？",
      "text": "在复数域计代数重数后，特征值之和等于迹、乘积等于行列式。迹只加对角线，不是所有元素。"
    }
  ],
  "formalDefinition": {
    "text": "特征多项式、迹与行列式",
    "latex": "p_A(\\lambda)=\\det(\\lambda I-A),\\quad\\sum_i\\lambda_i=\\operatorname{tr}A,\\quad\\prod_i\\lambda_i=\\det A",
    "conditions": [
      "特征值在复数域按代数重数计算；实矩阵的非实根成共轭对。"
    ]
  },
  "derivation": [
    {
      "text": "非零特征向量存在等价于奇异。",
      "latex": "\\lambda\\text{ 是特征值}\\iff\\det(\\lambda I-A)=0"
    },
    {
      "text": "多项式首两项给出总和。",
      "latex": "p_A(\\lambda)=\\lambda^n-(\\operatorname{tr}A)\\lambda^{n-1}+\\cdots"
    },
    {
      "text": "常数项给出乘积。",
      "latex": "p_A(0)=(-1)^n\\det A"
    }
  ],
  "workedExamples": [
    {
      "title": "对称二阶",
      "problem": "$A=\\begin{pmatrix}2&1\\\\1&2\\end{pmatrix}$ 的特征多项式？",
      "steps": [
        "$p=(\\lambda-2)^2-1$。",
        "$p=(\\lambda-3)(\\lambda-1)$。"
      ],
      "answer": "根为 $3,1$，和为 $4$，积为 $3$。"
    },
    {
      "title": "三角矩阵",
      "problem": "$A=\\begin{pmatrix}2&7&0\\\\0&-1&4\\\\0&0&2\\end{pmatrix}$ 的特征值？",
      "steps": [
        "特征矩阵仍为三角形，取对角积。",
        "$p=(\\lambda-2)^2(\\lambda+1)$。"
      ],
      "answer": "$2$ 的代数重数为 $2$，$-1$ 的重数为 $1$。"
    }
  ],
