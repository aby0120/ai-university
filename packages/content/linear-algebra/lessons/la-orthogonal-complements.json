  "formalDefinition": {
    "text": "正交补与正交分解",
    "latex": "W^\\perp=\\{z:z^Tw=0\\ \\forall w\\in W\\},\\quad \\mathbb R^n=W\\oplus W^\\perp",
    "conditions": [
      "使用有限维实欧氏空间；直和表示表示唯一，不只是两个集合的并集。"
    ]
  },
  "derivation": [
