      "latex": "b=QQ^Tb+(I-QQ^T)b"
    },
    {
      "text": "两种分解相减，交集只有零。",
      "latex": "w=z\\in W\\cap W^\\perp\\Rightarrow\\|w\\|^2=0"
    }
  ],
