  "body": [
    {
      "title": "怎样逐步算？",
      "text": "先对第一个对角元素开正平方根，再确定同列下方元素；减去已解释部分后，对剩余子块重复。"
    },
    {
      "title": "为什么正定很重要？",
      "text": "正定保证过程中的剩余主元严格为正，可以继续取实的正平方根。半正定或不定情形不能直接照搬这个无主元版本。"
    },
    {
      "title": "分解怎么用于求解？",
      "text": "先解 $Ly=b$，再解 $L^Tx=y$。二次型则成为 $\\|L^Tx\\|^2$，正定性一目了然。"
    }
  ],
  "formalDefinition": {
    "text": "Cholesky 分解与完成平方",
    "latex": "A=LL^T,\\quad L\\text{ 下三角且 }l_{ii}>0,\\qquad x^TAx=\\|L^Tx\\|^2",
    "conditions": [
      "实对称正定方阵；正对角约定使分解唯一。浮点误差可能使接近退化的判别需要谨慎处理。"
    ]
  },
  "derivation": [
    {
      "text": "对称二阶矩阵先取第一个根。",
      "latex": "l_{11}=\\sqrt{a_{11}},\\quad l_{21}=a_{21}/l_{11}"
    },
    {
      "text": "从第二个对角元素扣掉已贡献部分。",
      "latex": "l_{22}=\\sqrt{a_{22}-l_{21}^2}"
    },
    {
      "text": "正定保证根号内为正。",
      "latex": "a_{22}-\\frac{a_{21}^2}{a_{11}}>0"
    }
  ],
  "workedExamples": [
    {
      "title": "一个实际分解",
      "problem": "$A=\\begin{pmatrix}4&2\\\\2&3\\end{pmatrix}$。",
      "steps": [
        "$l_{11}=2,l_{21}=1$。",
        "$l_{22}=\\sqrt{3-1}=\\sqrt2$。"
      ],
      "answer": "$L=\\begin{pmatrix}2&0\\\\1&\\sqrt2\\end{pmatrix}$。"
    },
    {
      "title": "读成平方和",
      "problem": "将 $4x^2+4xy+3y^2$ 完成平方。",
      "steps": [
        "由上例 $L^T(x,y)=(2x+y,\\sqrt2y)$。",
        "取长度平方得到 $(2x+y)^2+2y^2$。"
