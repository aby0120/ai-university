  "title": "内积、长度与角度",
  "subtitle": "对齐程度、长度与角度",
  "concept": "内积把对齐程度变成一个数，并由此定义长度和距离。",
  "intuition": "同向贡献为正、反向贡献为负；垂直方向的贡献抵消为零。",
  "objectives": [
    "计算内积、范数和距离",
    "检查夹角公式的条件"
  ],
  "body": [
    {
      "title": "标准内积怎么算？",
      "text": "实坐标向量逐分量相乘再求和。长度为 $\\|x\\|=\\sqrt{x^Tx}$，距离为差向量的长度。"
    },
    {
      "title": "怎样读出角度？",
      "text": "非零向量的夹角满足 $\\cos\\theta=x^Ty/(\\|x\\|\\|y\\|)$。零向量没有这样定义的角度。"
    },
    {
      "title": "什么保证这些定义可靠？",
      "text": "实内积对两个变量线性、对称，并且对非零向量正定。任意双线性式未必能定义长度。"
    }
  ],
  "formalDefinition": {
    "text": "内积、长度与角度",
    "latex": "\\langle x,y\\rangle=x^Ty,\\quad |x^Ty|\\le\\|x\\|\\|y\\|,\\quad \\|x+y\\|\\le\\|x\\|+\\|y\\|",
    "conditions": [
      "本节使用实欧氏内积；夹角要求两个向量都非零。Cauchy–Schwarz 与三角不等式的证明见附录。"
    ]
  },
  "derivation": [
    {
      "text": "非负平方构造约束。",
      "latex": "0\\le\\|x-ty\\|^2=\\|x\\|^2-2t x^Ty+t^2\\|y\\|^2"
    },
    {
      "text": "在非零方向取最优标量。",
      "latex": "t=\\frac{x^Ty}{\\|y\\|^2}\\Rightarrow (x^Ty)^2\\le\\|x\\|^2\\|y\\|^2"
    },
    {
      "text": "展开和的平方得到三角不等式。",
      "latex": "\\|x+y\\|^2\\le(\\|x\\|+\\|y\\|)^2"
    }
  ],
