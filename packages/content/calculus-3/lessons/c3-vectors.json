  "body": [
    {
      "title": "点和向量有什么区别？",
      "text": "点是位置。由点 $A$ 指向点 $B$ 的向量是 $B-A$；平移起点不会改变这个向量。"
    },
    {
      "title": "长度怎么算？",
      "text": "对三方向位移用勾股定理。长度非负，只有零向量长度为零。距离是两点之差的长度。"
    },
    {
      "title": "单位向量有什么用？",
      "text": "非零向量除以自身长度后只保留方向。负倍数反向，零向量没有可归一化的方向。"
    }
  ],
  "formalDefinition": {
    "text": "位置是点，位移是向量",
    "latex": "\\mathbf v=\\langle v_1,v_2,v_3\\rangle,\\quad\\|\\mathbf v\\|=\\sqrt{v_1^2+v_2^2+v_3^2},\\quad\\widehat{\\mathbf v}=\\frac{\\mathbf v}{\\|\\mathbf v\\|}",
    "conditions": [
      "本卷使用正交直角坐标与欧氏距离；归一化要求 $\\mathbf v\\ne\\mathbf0$。"
    ]
  },
  "derivation": [
    {
      "text": "先减出位移。",
      "latex": "\\overrightarrow{AB}=\\langle B_1-A_1,B_2-A_2,B_3-A_3\\rangle"
    },
    {
      "text": "两段位移首尾连接。",
      "latex": "\\overrightarrow{AB}+\\overrightarrow{BC}=\\overrightarrow{AC}"
    },
    {
      "text": "缩放所有分量时长度按绝对值缩放。",
      "latex": "\\|c\\mathbf v\\|=|c|\\|\\mathbf v\\|"
    }
  ],
