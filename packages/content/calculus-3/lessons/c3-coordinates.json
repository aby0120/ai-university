  "body": [
    {
      "title": "角度从哪里量？",
      "text": "本卷方位角 $\\theta$ 在水平面从正横轴量起；倾角 $\\phi$ 从正竖轴向下量，范围从零到 $\\pi$。"
    },
    {
      "title": "坐标唯一吗？",
      "text": "角度加整周不改变点。在轴上方位角不唯一，原点的角度都不唯一；这是坐标退化，并不是多个空间点。"
    },
    {
      "title": "先记变换还是体积元？",
      "text": "先把位置关系画清。面积、体积缩放因子会在重积分中推导，不能把三个微分直接相乘当真实体积。"
    }
  ],
  "formalDefinition": {
    "text": "让坐标顺着几何形状走",
    "latex": "x=r\\cos\\theta,\\ y=r\\sin\\theta;\\quad x=\\rho\\sin\\phi\\cos\\theta,\\ y=\\rho\\sin\\phi\\sin\\theta,\\ z=\\rho\\cos\\phi",
    "conditions": [
      "柱坐标 $r\\ge0$；球坐标 $\\rho\\ge0,0\\le\\phi\\le\\pi$；方位角按整周等价；角度使用弧度。"
    ]
  },
  "derivation": [
    {
      "text": "先将点投影到水平面。",
      "latex": "r=\\sqrt{x^2+y^2}"
    },
    {
      "text": "再用到原点的距离和倾角。",
      "latex": "\\rho=\\sqrt{r^2+z^2},\\quad r=\\rho\\sin\\phi"
    },
    {
      "text": "在水平面分解半径。",
      "latex": "x=r\\cos\\theta,\\quad y=r\\sin\\theta"
    }
  ],
  "workedExamples": [
    {
      "title": "读出球坐标",
      "problem": "$(x,y,z)=(1,1,\\sqrt2)$ 的球坐标？",
      "steps": [
        "距离 $\\rho=2$，水平半径 $r=\\sqrt2$。",
        "第一象限给 $\\theta=\\frac\\pi4$，$\\cos\\phi=\\frac{\\sqrt2}2$。"
      ],
      "answer": "$(\\rho,\\theta,\\phi)=(2,\\frac\\pi4,\\frac\\pi4)$。"
    },
    {
      "title": "坐标面",
      "problem": "球坐标 $\\phi=\\frac\\pi3$ 描述什么？",
      "steps": [
        "$z=\\rho/2\\ge0$，$r=\\sqrt3\\rho/2$。",
        "消去距离得到 $z=r/\\sqrt3$。"
      ],
      "answer": "上半空间的圆锥面，含原点。"
    }
  ],
