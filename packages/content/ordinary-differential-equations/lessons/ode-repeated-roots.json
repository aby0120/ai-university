    {
      "text": "令 $w=v'$，分离并积分。",
      "latex": "w=C\\frac{e^{-\\int pdt}}{y_1^2}"
    },
    {
      "text": "重根情形的积分只留下时间。",
      "latex": "p=-2r,\\quad y_1=e^{rt}\\Rightarrow y_2=te^{rt}"
    }
  ],
