  "body": [
    {
      "title": "导数规则",
      "text": "记 $Y=\\mathcal L\\{y\\}$，则 $\\mathcal L\\{y'\\}=sY-y(0^+)$。"
    },
    {
      "title": "二阶多一个初值",
      "text": "再次使用规则得到 $\\mathcal L\\{y''\\}=s^2Y-sy(0^+)-y'(0^+)$。"
    },
    {
      "title": "最后怎样查？",
      "text": "逆变换后，分别检查初值和原方程；分段外力还要检查开关时刻的连续性条件。"
    }
  ],
  "derivation": [
    {
      "text": "对一阶导数分部积分。",
      "latex": "\\int_0^\\infty e^{-st}y'dt=[e^{-st}y]_0^\\infty+sY"
    },
    {
      "text": "在收敛右半平面上边界项消失。",
      "latex": "\\mathcal L\\{y'\\}=sY-y(0^+)"
    },
    {
      "text": "再用一次规则。",
      "latex": "\\mathcal L\\{y''\\}=s(sY-y(0^+))-y'(0^+)"
    }
  ],
  "workedExamples": [
    {
      "title": "一阶恒定输入",
      "problem": "解 $y'+y=1,y(0)=0$。",
      "steps": [
        "变换得 $(s+1)Y=1/s$。",
        "部分分式为 $Y=1/s-1/(s+1)$。"
      ],
      "answer": "$y=1-e^{-t}$。"
    },
    {
      "title": "二阶自由运动",
      "problem": "解 $y''+4y=0,y(0)=0,y'(0)=3$。",
      "steps": [
        "变换得 $(s^2+4)Y=3$。",
        "匹配正弦公式。"
      ],
      "answer": "$y=3\\sin2t/2$。"
    }
  ],
