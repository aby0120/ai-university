{
  "id": "c2-sequences",
  "title": "数列与极限",
  "subtitle": "看第几项，而不是看连续时间",
  "concept": "数列的极限描述后面的每一项是否最终留在某个数附近；前面有限项不决定极限。",
  "intuition": "$a_n=\\frac1n$ 越来越靠近零，却没有任何一项等于零。数列只在整数位置取值。",
  "body": [
    {
      "title": "怎样把“靠近”说清？",
      "text": "任给正容差，都能找到一个项数，使后面所有项与极限的距离小于这个容差。不是只有某些项靠近。"
    },
    {
      "title": "怎样计算？",
      "text": "可用极限运算法则、夹逼或与已知连续函数连接。分母极限不为零时，才能直接使用商法则。"
    },
    {
      "title": "振荡一定发散吗？",
      "text": "幅度缩到零的振荡仍可收敛。$(-1)^n$ 发散，而 $\\frac{(-1)^n}{n}$ 收敛到零。"
    }
  ],
  "formalDefinition": {
    "text": "看第几项，而不是看连续时间",
    "latex": "a_n\\to L\\iff\\forall\\varepsilon>0\\ \\exists N\\ \\forall n\\geq N:\\ |a_n-L|<\\varepsilon",
    "conditions": [
      "项数 $n$ 为正整数；$N$ 可依赖容差，但不能依赖后面所选的某一项。"
    ]
  },
  "derivation": [
    {
      "text": "用目标容差控制倒数。",
      "latex": "\\left|\\frac1n-0\\right|<\\varepsilon\\iff n>\\frac1\\varepsilon"
    },
    {
      "text": "选择严格更大的整数阈值。",
      "latex": "N>\\frac1\\varepsilon"
    },
    {
      "text": "阈值以后的每项都满足要求。",
      "latex": "n\\geq N\\Longrightarrow\\frac1n\\leq\\frac1N<\\varepsilon"
    }
  ],
  "workedExamples": [
    {
      "title": "多项式比值",
      "problem": "求 $\\lim_{n\\to\\infty}\\frac{3n+1}{2n-5}$。",
      "steps": [
        "分子分母同除以 $n$，得到 $\\frac{3+1/n}{2-5/n}$。",
        "分母趋于 2，不为零，可用商法则。"
      ],
      "answer": "$\\frac32$。"
    },
    {
      "title": "振荡但收敛",
      "problem": "求 $\\lim\\frac{\\sin n}{n}$。",
      "steps": [
        "用 $|\\sin n|\\leq1$，得 $|\\frac{\\sin n}{n}|\\leq\\frac1n$。",
        "右侧趋于零，夹逼得原数列趋于零。"
      ],
      "answer": "$0$。"
    }
  ],
