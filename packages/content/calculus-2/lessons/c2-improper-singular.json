  "formalDefinition": {
    "text": "每个危险点都要单独靠近",
    "latex": "\\int_0^1x^{-p}dx=\\lim_{\\delta\\to0^+}\\int_\\delta^1x^{-p}dx=\\frac1{1-p}\\quad(p<1)",
    "conditions": [
      "截断点从区间内部靠近奇点；每个奇点的每个相关侧都要检查。"
    ]
  },
  "derivation": [
    {
      "text": "先避开零。",
      "latex": "\\int_\\delta^1x^{-p}dx=\\frac{1-\\delta^{1-p}}{1-p}\\quad(p\\neq1)"
    },
    {
      "text": "正指数使下端项消失。",
      "latex": "p<1\\Longrightarrow\\delta^{1-p}\\to0"
    },
    {
      "text": "临界值仍发散。",
      "latex": "\\int_\\delta^1\\frac{dx}{x}=-\\ln\\delta\\to\\infty"
    }
  ],
