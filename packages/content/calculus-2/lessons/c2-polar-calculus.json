  "title": "极坐标的面积与弧长",
  "subtitle": "面积用扇形，长度用参数速度",
  "concept": "极坐标面积累积小扇形，弧长累积小弧；先确认曲线描绘范围，避免重复计数。",
  "intuition": "小扇形面积约为 $\\frac12r^2\\Delta\\theta$；半径改变还会增加弧长，所以长度公式同时含半径与半径变化率。",
  "body": [
    {
      "title": "面积为什么除以二？",
      "text": "完整圆面积按角度比例分给小扇形：$\\pi r^2\\cdot\\frac{\\Delta\\theta}{2\\pi}$。"
    },
    {
      "title": "两个极曲线之间呢？",
      "text": "在相同角度范围内，若 $0\\leq r_{in}\\leq r_{out}$，面积是两个平方半径之差的一半积分。交点与描绘范围先分段。"
    },
    {
      "title": "弧长怎么来？",
      "text": "把 $x=r\\cos\\theta,y=r\\sin\\theta$ 代进参数弧长；平方相加时交叉项抵消。"
    }
  ],
  "formalDefinition": {
    "text": "面积用扇形，长度用参数速度",
    "latex": "A=\\frac12\\int_\\alpha^\\beta r(\\theta)^2d\\theta,\\qquad L=\\int_\\alpha^\\beta\\sqrt{r(\\theta)^2+r\\prime(\\theta)^2}\\,d\\theta",
    "conditions": [
      "面积公式用于不重复覆盖的径向区域，通常取非负连续半径；弧长要求分段连续可导，重复描绘会重复计数。"
    ]
  },
  "derivation": [
    {
      "text": "以小扇形近似面积。",
      "latex": "\\Delta A\\approx\\frac12r^2\\Delta\\theta"
    },
    {
      "text": "对两个坐标求导后相加平方。",
      "latex": "\\left(\\frac{dx}{d\\theta}\\right)^2+\\left(\\frac{dy}{d\\theta}\\right)^2=(r\\prime)^2+r^2"
    },
    {
      "text": "得到面积与长度的不同积分。",
      "latex": "dA=\\frac12r^2d\\theta,\\quad ds=\\sqrt{r^2+(r\\prime)^2}\\,d\\theta"
    }
  ],
  "workedExamples": [
