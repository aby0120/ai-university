    {
      "title": "极坐标圆",
      "problem": "$r=2\\cos\\theta$ 是什么曲线？",
      "steps": [
        "乘以 $r$ 得 $r^2=2r\\cos\\theta$。",
        "因此 $x^2+y^2=2x$，配方为 $(x-1)^2+y^2=1$。"
      ],
      "answer": "圆心 $(1,0)$、半径 1 的圆；$-\\frac\\pi2\\leq\\theta\\leq\\frac\\pi2$ 描一圈。"
    }
  ],
