    {
      "text": "乘带符号半径得到点。",
      "latex": "(x,y)=r\\mathbf e_\\theta"
    },
    {
      "text": "反方向同时改半径符号，点不变。",
      "latex": "(-r)(\\cos(\\theta+\\pi),\\sin(\\theta+\\pi))=(r\\cos\\theta,r\\sin\\theta)"
    }
  ],
  "workedExamples": [
