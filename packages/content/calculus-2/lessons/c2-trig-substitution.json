{
  "id": "c2-trig-substitution",
  "title": "三角代换",
  "subtitle": "用恒等式消掉根号里的平方和或平方差",
  "concept": "根号结构决定代换；选定角度区间，才能正确去掉绝对值。",
  "intuition": "$x=a\\sin\\theta$ 把 $\\sqrt{a^2-x^2}$ 变成 $a|\\cos\\theta|$。选择 $-\\frac\\pi2\\leq\\theta\\leq\\frac\\pi2$ 后，余弦非负。",
  "body": [
    {
      "title": "三种根式怎么选？",
      "text": "$a^2-x^2$ 用正弦，$a^2+x^2$ 用正切，$x^2-a^2$ 可在 $x\\geq a$ 分支用正割；其中 $a>0$。"
    },
    {
      "title": "为什么要画三角形？",
      "text": "三角形帮助把角函数换回原变量。它只编码某个分支的比例，不能自动覆盖所有正负情况。"
    },
    {
      "title": "代换后多出什么？",
      "text": "除了根式，$dx$ 也会改变。分母的根号往往正好和微分里的因子抵消。"
    }
  ],
  "formalDefinition": {
    "text": "用恒等式消掉根号里的平方和或平方差",
    "latex": "x=a\\sin\\theta\\quad\\Longrightarrow\\quad dx=a\\cos\\theta\\,d\\theta,\\quad\\sqrt{a^2-x^2}=a\\cos\\theta",
    "conditions": [
      "$a>0$ 且 $\\theta\\in[-\\frac\\pi2,\\frac\\pi2]$；含分母时排除端点。"
    ]
  },
  "derivation": [
    {
      "text": "对半圆面积积分做代换。",
      "latex": "\\int\\sqrt{a^2-x^2}\\,dx=a^2\\int\\cos^2\\theta\\,d\\theta"
    },
    {
      "text": "降幂后积分。",
      "latex": "=\\frac{a^2}{2}(\\theta+\\sin\\theta\\cos\\theta)+C"
    },
    {
      "text": "回到原变量。",
      "latex": "=\\frac12\\left(a^2\\arcsin\\frac xa+x\\sqrt{a^2-x^2}\\right)+C"
    }
  ],
  "workedExamples": [
    {
      "title": "根式在分母",
      "problem": "求 $\\int\\frac{dx}{\\sqrt{9-x^2}}$。",
      "steps": [
        "令 $x=3\\sin\\theta$，$dx=3\\cos\\theta d\\theta$，选余弦为正的分支。",
        "积分变成 $\\int d\\theta$，最后换回反正弦。"
      ],
      "answer": "$\\arcsin\\frac x3+C$，$-3<x<3$。"
    },
    {
      "title": "平方和",
      "problem": "求 $\\int\\frac{dx}{x^2+4}$。",
      "steps": [
        "令 $x=2\\tan\\theta$，分母变为 $4\\sec^2\\theta$。",
        "$dx=2\\sec^2\\theta d\\theta$，故积分为 $\\frac12\\theta+C$。"
      ],
      "answer": "$\\frac12\\arctan\\frac x2+C$。"
    },
    {
      "title": "平方和根式：代换后再分解",
      "problem": "求 $\\int\\frac{x^2}{\\sqrt{x^2+4}}\\,dx$。",
      "steps": [
        "令 $x=2\\tan\\theta$，取 $-\\pi/2<\\theta<\\pi/2$，于是 $\\sqrt{x^2+4}=2\\sec\\theta>0$，$dx=2\\sec^2\\theta\\,d\\theta$。",
        "积分变成 $4\\int(\\sec^3\\theta-\\sec\\theta)\\,d\\theta$。由分部积分得 $\\int\\sec^3\\theta\\,d\\theta=\\tfrac12(\\sec\\theta\\tan\\theta+\\ln|\\sec\\theta+\\tan\\theta|)+C$，故结果是 $2\\sec\\theta\\tan\\theta-2\\ln|\\sec\\theta+\\tan\\theta|+C$。",
        "代回 $\\tan\\theta=x/2$、$\\sec\\theta=\\sqrt{x^2+4}/2$。对数中的常数因子并入 $C$；$x+\\sqrt{x^2+4}>0$ 对所有实数成立。"
      ],
      "answer": "$\\frac{x\\sqrt{x^2+4}}2-2\\ln(x+\\sqrt{x^2+4})+C$，$x\\in\\mathbb R$。"
    }
  ],
