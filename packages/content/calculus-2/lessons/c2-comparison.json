{
  "id": "c2-comparison",
  "title": "比较与极限比较",
  "subtitle": "找到一个已经认识的尾部",
  "concept": "正项级数可与已知级数比大小；极限比较则检查两种尾部是否只差有限正倍数。",
  "intuition": "当 $n$ 很大时，$\\frac1{n^2+1}$ 像 $\\frac1{n^2}$。极限比较把“像”变成严格可用的比例关系。",
  "body": [
    {
      "title": "大小方向怎么记？",
      "text": "小于收敛正项级数，则收敛；大于发散正项级数，则发散。反过来两种比较都不能得结论。"
    },
    {
      "title": "极限比较要求什么？",
      "text": "两列最终为正，比例极限为有限正数，才同敛散。比例为零或无穷时可有单向结论，但不能直接说同敛散。"
    },
    {
      "title": "怎么挑参照？",
      "text": "有理式先看最高次幂；根式比较主要增长率；不要把有限开头的大小当作尾部行为。"
    }
  ],
  "formalDefinition": {
    "text": "找到一个已经认识的尾部",
    "latex": "a_n,b_n>0,\\quad\\lim_{n\\to\\infty}\\frac{a_n}{b_n}=c\\in(0,\\infty)\\ \\Longrightarrow\\ \\sum a_n,\\sum b_n\\text{ 同敛散}",
    "conditions": [
      "最终正项；有限个初始项不影响收敛性。"
    ]
  },
  "derivation": [
    {
      "text": "比例趋于正数，最终会被两个正倍数夹住。",
      "latex": "\\frac c2b_n\\leq a_n\\leq\\frac{3c}{2}b_n\\quad(n\\geq N)"
    },
    {
      "text": "参照级数收敛时，用上界比较。",
      "latex": "\\sum b_n<\\infty\\Longrightarrow\\sum a_n<\\infty"
    },
    {
      "text": "参照级数发散时，用下界比较。",
      "latex": "\\sum b_n=\\infty\\Longrightarrow\\sum a_n=\\infty"
    }
  ],
  "workedExamples": [
    {
      "title": "直接比较",
      "problem": "$\\sum\\frac1{n^2+1}$ 收敛吗？",
      "steps": [
        "$0<\\frac1{n^2+1}\\leq\\frac1{n^2}$。",
        "平方倒数级数收敛，所以更小的正项和收敛。"
      ],
      "answer": "收敛。"
    },
    {
      "title": "极限比较",
      "problem": "$\\sum\\frac{3n+1}{n^2+5}$ 收敛吗？",
      "steps": [
        "与 $b_n=\\frac1n$ 比，比例为 $\\frac{3n^2+n}{n^2+5}\\to3$。",
        "调和级数发散，比例极限为有限正数。"
      ],
      "answer": "发散。"
    }
  ],
