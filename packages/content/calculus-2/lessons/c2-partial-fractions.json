  "title": "部分分式",
  "subtitle": "把有理函数拆成能逐项积分的小块",
  "concept": "分母能分解时，把一个分式拆成几个简单分式；先做除法，再比较系数。",
  "intuition": "$\\frac1{x(x+1)}=\\frac1x-\\frac1{x+1}$。两项虽然各自更简单，合起来仍是原函数。",
  "body": [
    {
      "title": "分子次数太高？",
      "text": "先做多项式除法，让余下分子的次数低于分母。部分分式针对的是真分式。"
    },
    {
      "title": "分母有重根或二次因子？",
      "text": "重根 $(x-a)^m$ 要从一次列到 $m$ 次；不可约二次因子上方用一次式 $Ax+B$，重复二次因子也逐次列出。"
    },
    {
      "title": "积分后怎样检查？",
      "text": "先通分检查分解，再求导检查原函数。对数写绝对值；每个被极点分开的区间可有不同常数。"
    }
  ],
  "formalDefinition": {
    "text": "把有理函数拆成能逐项积分的小块",
    "latex": "\\frac1{x(x+1)}=\\frac1x-\\frac1{x+1},\\quad\\int\\frac{dx}{x(x+1)}=\\ln|x|-\\ln|x+1|+C",
    "conditions": [
      "$x\\neq0,-1$；在不跨极点的连通区间内积分。"
    ]
  },
  "derivation": [
    {
      "text": "设未知系数并通分。",
      "latex": "1=A(x+1)+Bx"
    },
    {
      "text": "比较常数与一次项。",
      "latex": "A=1,\\quad A+B=0"
    },
    {
      "text": "逐项积分。",
      "latex": "\\int\\left(\\frac1x-\\frac1{x+1}\\right)dx=\\ln\\left|\\frac{x}{x+1}\\right|+C"
    }
  ],
  "workedExamples": [
    {
      "title": "不同的一次因子",
      "problem": "求 $\\int\\frac{3x+1}{x(x+1)}dx$。",
      "steps": [
        "令 $3x+1=A(x+1)+Bx$，得 $A=1,B=2$。",
        "分别积分 $\\frac1x$ 与 $\\frac2{x+1}$。"
      ],
      "answer": "$\\ln|x|+2\\ln|x+1|+C$。"
    },
