  "body": [
    {
      "title": "公比为什么必须小于一？",
      "text": "有限和的剩余项含 $r^{N+1}$。只有 $|r|<1$ 才会趋零；$r=1$ 需单算，$r=-1$ 会振荡。"
    },
    {
      "title": "起始项重要吗？",
      "text": "从零次幂开始和从一次幂开始差一项。先列前两项，避免整个答案少乘一个公比。"
    },
    {
      "title": "望远镜要看哪些项？",
      "text": "写出前几项与最后几项，确认抵消后留下什么。剩余边界项的极限才决定收敛性。"
    }
  ],
  "formalDefinition": {
    "text": "一种按比例缩小，一种让中间项抵消",
    "latex": "\\sum_{n=0}^N ar^n=\\frac{a(1-r^{N+1})}{1-r},\\qquad\\sum_{n=0}^\\infty ar^n=\\frac a{1-r}\\quad(|r|<1)",
    "conditions": [
      "有限和要求 $r\\neq1$；若 $a\\neq0$，无穷几何级数恰在 $|r|<1$ 收敛。"
    ]
  },
  "derivation": [
    {
      "text": "有限和乘公比后相减。",
      "latex": "(1-r)S_N=a-ar^{N+1}"
    },
    {
      "text": "解出有限和。",
      "latex": "S_N=\\frac{a(1-r^{N+1})}{1-r}"
    },
    {
      "text": "收敛范围内尾项消失。",
      "latex": "|r|<1\\Longrightarrow S_N\\to\\frac a{1-r}"
    }
  ],
