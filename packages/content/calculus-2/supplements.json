  "glossary": [
    {
      "term": "分部积分",
      "meaning": "分部积分把一个因子求导、另一个积分；目标是让剩下的积分更简单。",
      "lessonId": "c2-parts"
    },
    {
      "term": "三角函数的积分",
      "meaning": "奇次幂留出一个因子做微分；偶次幂用降幂公式。",
      "lessonId": "c2-trig-integrals"
    },
    {
      "term": "三角代换",
      "meaning": "根号结构决定代换；选定角度区间，才能正确去掉绝对值。",
      "lessonId": "c2-trig-substitution"
    },
    {
      "term": "部分分式",
      "meaning": "分母能分解时，把一个分式拆成几个简单分式；先做除法，再比较系数。",
      "lessonId": "c2-partial-fractions"
    },
    {
      "term": "怎样选择积分方法",
      "meaning": "先化简与找内层导数，再看乘积、根式或有理式；没有初等原函数，也不妨碍定积分存在。",
      "lessonId": "c2-strategy"
    },
    {
      "term": "数值积分与误差",
      "meaning": "梯形用直线贴曲线，Simpson 用抛物线；误差界告诉你需要分多少段。",
      "lessonId": "c2-numerical"
    },
    {
      "term": "无穷区间上的积分",
      "meaning": "无穷区间的积分是截断积分的极限；无穷远不是可以直接代入的普通数。",
      "lessonId": "c2-improper-infinity"
    },
    {
      "term": "有限区间里的无界点",
      "meaning": "函数在端点或内部无界时，避开无界点积分，再取单侧极限。",
      "lessonId": "c2-improper-singular"
    },
    {
      "term": "旋转曲面的面积",
      "meaning": "旋转侧面积把每段小弧转成窄带：窄带面积约为圆周长乘弧长。",
      "lessonId": "c2-surface"
    },
    {
      "term": "质量、力矩与质心",
      "meaning": "质心是质量的加权平均位置，不是形状边界的简单平均。",
      "lessonId": "c2-moments"
    },
    {
      "term": "压力与做功的分层模型",
      "meaning": "总力和总功都靠分层累积；每层的受力或移动距离可能不同。",
