  "body": [
    {
      "title": "定义顶点度数",
      "text": "简单无向图的度数是邻居数。若允许自环，则自环对度数贡献二，本卷交互不含自环。"
    },
    {
      "title": "推导握手引理",
      "text": "每条边有两个端点，所有度数加起来正好数每个端点一次。这是双重计数的直接应用。"
    },
    {
      "title": "检查度数可行性",
      "text": "度数和必须是偶数，奇度顶点个数也必须偶数。但这些只是必要条件，不保证任意度数序列都能实现为简单图。"
    }
  ],
  "formalDefinition": {
    "text": "有限无向图的奇度顶点数为偶数。",
    "latex": "\\sum_{v\\in V}\\deg(v)=2|E|",
    "conditions": [
      "计数对象为无向边端点。"
    ]
  },
  "derivation": [
    {
      "text": "按顶点统计端点。",
      "latex": "\\#\\text{端点}=\\sum_v\\deg(v)"
    },
    {
      "text": "按边统计端点。",
      "latex": "\\#\\text{端点}=2|E|"
    },
    {
      "text": "模二看奇数项个数。",
      "latex": "\\sum_v\\deg(v)\\equiv\\#\\{v:\\deg(v)\\text{ 奇}\\}\\equiv0\\pmod2"
    }
  ],
