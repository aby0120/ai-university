  "body": [
    {
      "title": "认识同余",
      "text": "两整数同余，是说它们的差被模数整除。用零到模数减一的余数作为每个类的代表。"
    },
    {
      "title": "进行运算",
      "text": "同余可逐项相加、相减、相乘。除法不能直接照搬，约去的因子必须对模数可逆。"
    },
    {
      "title": "计算大幂",
      "text": "反复平方并每次取余能避免数值快速膨胀。每步保留同余，而非保留原整数大小。"
    }
  ],
  "formalDefinition": {
    "text": "模数取正整数；模一仅有一个类。",
    "latex": "a\\equiv b\\pmod m\\iff m\\mid(a-b)",
    "conditions": [
      "本卷交互模数至少为二。",
      "约分必须另查可逆条件。"
    ]
  },
  "derivation": [
    {
      "text": "把同余写成整倍数差。",
      "latex": "a-b=km,\\quad c-d=\\ell m"
    },
    {
      "text": "乘积差可拆开。",
      "latex": "ac-bd=a(c-d)+d(a-b)"
    },
    {
      "text": "两项都被模数整除。",
      "latex": "ac\\equiv bd\\pmod m"
    }
  ],
