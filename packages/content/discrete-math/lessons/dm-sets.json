  "body": [
    {
      "title": "进行集合运算",
      "text": "交集保留共有元素，并集保留至少一边出现的元素，差集只保留左边独有元素。补集必须先指定全集。"
    },
    {
      "title": "区分元素与子集",
      "text": "一个元素属于集合，与一个集合的所有元素都属于另一个集合，是两种不同的关系。空集是每个集合的子集。"
    },
    {
      "title": "计算幂集",
      "text": "幂集收集所有子集。有限集合的每个元素都可选或不选，因此子集数是二的元素数次方。"
    }
  ],
  "formalDefinition": {
    "text": "幂集的元素是集合本身的子集。",
    "latex": "\\mathcal P(A)=\\{B:B\\subseteq A\\},\\quad |\\mathcal P(A)|=2^{|A|}",
    "conditions": [
      "幂集计数公式要求集合有限。",
      "补集相对于指定全集。"
    ]
  },
  "derivation": [
    {
      "text": "给每个元素一个成员开关。",
      "latex": "\\mathbf1_B(a)\\in\\{0,1\\}"
    },
    {
      "text": "每组开关唯一确定一个子集。",
      "latex": "B\\longleftrightarrow(\\mathbf1_B(a))_{a\\in A}"
    },
    {
      "text": "独立相乘。",
      "latex": "|\\mathcal P(A)|=2^{|A|}"
    }
  ],
