  "formalDefinition": {
    "text": "逻辑等价要求全部赋值的真值相同。",
    "latex": "\\neg(p\\land q)\\equiv\\neg p\\lor\\neg q",
    "conditions": [
      "只比较相同变量上的经典真值函数。"
    ]
  },
  "derivation": [
    {
      "text": "合取只有两项都真时为真。",
      "latex": "p\\land q=1\\iff p=q=1"
    },
    {
      "text": "取否定，排除两项都真。",
      "latex": "\\neg(p\\land q)=0\\iff p=q=1"
    },
    {
      "text": "右式也只有这时为假。",
      "latex": "\\neg p\\lor\\neg q=0\\iff p=q=1"
    }
  ],
