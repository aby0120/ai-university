      "title": "含乘积的关系",
      "problem": "对 $xy+y^2=6$ 求导。",
      "steps": [
        "xy 给 y+xy′，y² 给 2yy′。",
        "整理 y+(x+2y)y′=0。"
      ],
      "answer": "$y\\prime=-y/(x+2y)$，分母非零。"
    }
