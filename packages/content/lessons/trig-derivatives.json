  "workedExamples": [
    {
      "title": "缩短周期后的速度",
      "problem": "求 $y=\\sin(4x)$ 的导数。",
      "steps": [
        "外层给 cos(4x)。",
        "内层给 4，连乘。"
      ],
      "answer": "$y\\prime=4\\cos(4x)$。"
    },
    {
      "title": "积与三角函数",
      "problem": "求 $y=x\\cos x$ 的导数。",
      "steps": [
        "积法则给 1·cos x+x·(−sin x)。",
        "第二项的负号必须保留。"
      ],
      "answer": "$y\\prime=\\cos x-x\\sin x$。"
    }
  ],
