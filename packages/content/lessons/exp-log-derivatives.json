  "workedExamples": [
    {
      "title": "链式指数",
      "problem": "求 $e^{3x^2}$ 的导数。",
      "steps": [
        "外层指数保持 e^(3x²)。",
        "内部 3x² 的导数为 6x。"
      ],
      "answer": "$6x e^{3x^2}$。"
    },
    {
      "title": "变量既是底数又是指数",
      "problem": "求 $x^x$ 的导数（x>0）。",
      "steps": [
        "令 y=x^x，取 ln y=x ln x。",
        "求导：y′/y=ln x+1，再乘回 y。"
      ],
      "answer": "$x^x(\\ln x+1)$。"
    }
  ],
