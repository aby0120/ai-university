      "steps": [
        "原式为 0/0，分母导数为 1。",
        "导数比为 e^x，趋近 1。"
      ],
      "answer": "极限为 1。"
    },
    {
      "title": "对数与线性增长",
      "problem": "求 $\\lim_{x\\to\\infty}\\ln x/x$。",
      "steps": [
